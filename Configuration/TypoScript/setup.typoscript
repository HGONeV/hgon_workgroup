
config.tx_extbase {
    persistence {
        GeorgRinger\News\Domain\Model\News.newRecordStoragePid = 60
    }
}

# Legacy list_type fallback (pre-migration)
tt_content.list.20 {
    hgonworkgroup_list < tt_content.hgonworkgroup_list
    hgonworkgroup_detail < tt_content.hgonworkgroup_detail
    hgonworkgroup_header < tt_content.hgonworkgroup_header
    hgonworkgroup_sidebar < tt_content.hgonworkgroup_sidebar
    hgonworkgroup_search < tt_content.hgonworkgroup_search
}



